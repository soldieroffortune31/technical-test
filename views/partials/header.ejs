<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %> - CodingTest App</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet" />
  <style>
    :root {
      --sidebar-width: 250px;
      --primary: #4f46e5;
    }
    body { background: #f8f9fa; font-family: 'Segoe UI', sans-serif; }
    .sidebar {
      width: var(--sidebar-width);
      min-height: 100vh;
      background: #1e1b4b;
      position: fixed;
      top: 0; left: 0;
      padding: 0;
      z-index: 100;
    }
    .sidebar-brand {
      padding: 1.25rem 1.5rem;
      color: #fff;
      font-weight: 700;
      font-size: 1.2rem;
      background: #4f46e5;
      display: block;
      text-decoration: none;
    }
    .sidebar .nav-link {
      color: #a5b4fc;
      padding: .6rem 1.5rem;
      display: flex;
      align-items: center;
      gap: .6rem;
      transition: all .2s;
    }
    .sidebar .nav-link:hover,
    .sidebar .nav-link.active {
      color: #fff;
      background: rgba(255,255,255,.1);
      border-left: 3px solid #818cf8;
    }
    .sidebar .nav-section {
      padding: .75rem 1.5rem .25rem;
      font-size: .7rem;
      text-transform: uppercase;
      letter-spacing: .1em;
      color: #6366f1;
    }
    .main-content {
      margin-left: var(--sidebar-width);
      padding: 0;
    }
    .topbar {
      background: #fff;
      border-bottom: 1px solid #e5e7eb;
      padding: .85rem 1.5rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      position: sticky;
      top: 0;
      z-index: 50;
    }
    .page-body { padding: 1.5rem; }
    .card { border: none; box-shadow: 0 1px 3px rgba(0,0,0,.08); border-radius: .75rem; }
    .card-header { background: none; border-bottom: 1px solid #f3f4f6; padding: 1rem 1.25rem; font-weight: 600; }
    .btn-primary { background: var(--primary); border-color: var(--primary); }
    .btn-primary:hover { background: #4338ca; border-color: #4338ca; }
    .badge-success { background: #d1fae5; color: #065f46; }
    .badge-warning { background: #fef3c7; color: #92400e; }
    .badge-danger { background: #fee2e2; color: #991b1b; }
    .badge-info { background: #dbeafe; color: #1e40af; }
    table thead th { background: #f9fafb; font-size: .8rem; text-transform: uppercase; letter-spacing: .05em; }
  </style>
</head>
<body>

<!-- Sidebar -->
<nav class="sidebar">
  <a href="/dashboard" class="sidebar-brand">
    <i class="bi bi-code-slash me-2"></i>Technical Test
  </a>
  <div class="mt-2">
    <div class="nav-section">Main</div>
    <a href="/dashboard" class="nav-link <%= (typeof currentPage !== 'undefined' && currentPage === 'dashboard') ? 'active' : '' %>">
      <i class="bi bi-speedometer2"></i> Dashboard
    </a>

    <div class="nav-section">Data</div>
    <a href="/products" class="nav-link <%= (typeof currentPage !== 'undefined' && currentPage === 'products') ? 'active' : '' %>">
      <i class="bi bi-box-seam"></i> Produk (CRUD)
    </a>

    <div class="nav-section">Tools</div>
    <a href="/math/char-match" class="nav-link <%= (typeof currentPage !== 'undefined' && currentPage === 'char-match') ? 'active' : '' %>">
      <i class="bi bi-search"></i> Char Match
    </a>

    <div class="nav-section mt-3">Account</div>
    <a href="/auth/logout" class="nav-link text-danger">
      <i class="bi bi-box-arrow-right"></i> Logout
    </a>
  </div>
</nav>

<!-- Main -->
<div class="main-content">
  <div class="topbar">
    <h6 class="mb-0 fw-semibold"><%= title %></h6>
    <div class="d-flex align-items-center gap-2">
      <span class="badge bg-light text-dark border">
        <i class="bi bi-person-circle me-1"></i><%= typeof session !== 'undefined' && session.username ? session.username : 'User' %>
      </span>
    </div>
  </div>
  <div class="page-body">
